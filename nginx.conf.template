# Map real client IP by checking CF-Connecting-IP (Cloudflare) -> $remote_addr
map $http_cf_connecting_ip $real_client_ip {
    "~." $http_cf_connecting_ip;
    default $remote_addr;
}

log_format custom_combined '$real_client_ip - $remote_user [$time_local] "$request" '
                           '$status $body_bytes_sent "$http_referer" '
                           '"$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 80;
    server_name _;

    access_log /var/log/nginx/access.log custom_combined;

    # Trust upstream reverse proxies (Docker bridge/host, Cloudflare, Traefik)
    # to extract the actual client IP into $remote_addr.
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location /streamer/dock {
        auth_basic "Streamer Dashboard";
        auth_basic_user_file /auth/.streamer_htpasswd;

        alias /var/www/streamer/dock.html;
        default_type text/html;
    }

    location /streamer/ {
        auth_basic "Streamer Dashboard";
        auth_basic_user_file /auth/.streamer_htpasswd;

        alias /var/www/streamer/;
        index dock.html;
    }

    location /streamer/api/ {
        auth_basic "Streamer Dashboard";
        auth_basic_user_file /auth/.streamer_htpasswd;

        proxy_pass http://${STREAM_UPSTREAM_HOST}:9997/v3/;
        proxy_http_version 1.1;

        # Clear Authorization header so MediaMTX internal API matches unauthenticated 'any' user without auth errors
        proxy_set_header Authorization "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $real_client_ip;
    }

    location / {
        auth_basic "Stream";
        auth_basic_user_file /auth/.htpasswd;

        proxy_pass http://${STREAM_UPSTREAM_HOST}:8889;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $real_client_ip;
    }
}
